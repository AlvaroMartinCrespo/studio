/**
 * @file This file contains Firestore Security Rules for the application.
 * @core_philosophy This ruleset enforces a strict user-ownership model for user profiles, projects, and blog posts. Contact form submissions are publicly creatable, but only accessible to authenticated users for reading.
 * @data_structure
 *   - /users/{userId}: Stores user profile data, secured by owner-only access.
 *   - /users/{userId}/projects/{projectId}: Stores project data, secured by owner-only access.
 *   - /users/{userId}/blog_posts/{blogPostId}: Stores blog post data, secured by owner-only access.
 *   - /contact_form_submissions/{contactFormSubmissionId}: Stores contact form submissions, publicly creatable, but read-protected.
 * @key_security_decisions
 *   - User listing is disallowed for privacy.
 *   - Ambiguous relationships default to strict owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *   - auth.uid: 'user123'
     *   - request.resource.data.id: 'user123'
     * @allow (get, list, update, delete) User with ID 'user123' can read, update, or delete their profile.
     *   - auth.uid: 'user123'
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     *   - auth.uid: 'user456'
     *   - request.resource.data.id: 'user123'
     * @deny (get, list, update, delete) User with ID 'user456' cannot read, update, or delete 'user123's profile.
     *   - auth.uid: 'user456'
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      // Allow the user to create their own profile if the ID matches their auth UID.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      // Allow the user to read, update, and delete their own profile.
      allow get, update, delete: if isSignedIn() && isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      // Do not allow listing all users
      allow list: if false;
    }

    /**
     * @description Controls access to project documents under a specific user.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) User with ID 'user123' can create a project under their profile.
     *   - auth.uid: 'user123'
     * @allow (get, list, update, delete) User with ID 'user123' can read, update, or delete their project.
     *   - auth.uid: 'user123'
     * @deny (create) User with ID 'user456' cannot create a project for 'user123'.
     *   - auth.uid: 'user456'
     * @deny (get, list, update, delete) User with ID 'user456' cannot read, update, or delete 'user123's project.
     *   - auth.uid: 'user456'
     * @principle Enforces document ownership for all operations on user projects.
     */
    match /users/{userId}/projects/{projectId} {
      // Only the owner can create a project.
      allow create: if isSignedIn() && isOwner(userId);
      // Only the owner can read, update, and delete their projects.
      allow get, update, delete: if isSignedIn() && isExistingOwner(userId);
      // Only the owner can list their projects.
      allow list: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to blog post documents under a specific user.
     * @path /users/{userId}/blog_posts/{blogPostId}
     * @allow (create) User with ID 'user123' can create a blog post under their profile.
     *   - auth.uid: 'user123'
     * @allow (get, list, update, delete) User with ID 'user123' can read, update, or delete their blog post.
     *   - auth.uid: 'user123'
     * @deny (create) User with ID 'user456' cannot create a blog post for 'user123'.
     *   - auth.uid: 'user456'
     * @deny (get, list, update, delete) User with ID 'user456' cannot read, update, or delete 'user123's blog post.
     *   - auth.uid: 'user456'
     * @principle Enforces document ownership for all operations on user blog posts.
     */
    match /users/{userId}/blog_posts/{blogPostId} {
      // Only the owner can create a blog post.
      allow create: if isSignedIn() && isOwner(userId);
      // Only the owner can read, update, and delete their blog posts.
      allow get, update, delete: if isSignedIn() && isExistingOwner(userId);
      // Only the owner can list their blog posts.
      allow list: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to contact form submission documents.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (create) Any user (even unauthenticated) can create a contact form submission.
     * @allow (get, list) Authenticated users can read contact form submissions.
     * @deny (update, delete) No one can update or delete a contact form submission.
     * @principle Allows public submissions but restricts reading to authenticated users.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      // Anyone can create a contact form submission.
      allow create: if true;
      // Only authenticated users can read contact form submissions.
      allow get, list: if isSignedIn();
      // No one can update or delete a contact form submission.
      allow update, delete: if false;
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
  }
}