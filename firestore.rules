/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, projects, and blog posts.
 * Only the authenticated user who owns the data can read, write, update, or delete it.
 * Contact form submissions are publicly writable, but only authenticated users can read them.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data.
 * - /users/{userId}/projects/{projectId}: Stores projects owned by a specific user.
 * - /users/{userId}/blog_posts/{blogPostId}: Stores blog posts owned by a specific user.
 * - /contact_form_submissions/{contactFormSubmissionId}: Stores contact form submissions.
 *
 * Key Security Decisions:
 * - User-owned data (profiles, projects, blog posts) is strictly controlled by the owner.
 * - Contact form submissions are publicly writable to allow unauthenticated users to submit forms.
 * - Contact form submissions are only readable by authenticated users.
 * - Listing of contact form submissions is allowed for authenticated users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the owner can read, update, or delete.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @allow (get) User with ID 'user123' reads their profile.
     * @allow (update) User with ID 'user123' updates their profile.
     * @allow (delete) User with ID 'user123' deletes their profile.
     * @deny (create) User with ID 'user456' attempts to create profile for 'user123'.
     * @deny (get) User with ID 'user456' attempts to read profile of 'user123'.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Secure user projects. Only the owner can read, create, update, or delete.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) User with ID 'user123' creates a project under their profile.
     * @allow (get) User with ID 'user123' reads project 'project456' under their profile.
     * @allow (update) User with ID 'user123' updates project 'project456' under their profile.
     * @allow (delete) User with ID 'user123' deletes project 'project456' under their profile.
     * @deny (create) User with ID 'user456' attempts to create a project for 'user123'.
     * @deny (get) User with ID 'user456' attempts to read a project of 'user123'.
     * @principle Enforces document ownership for all operations on user projects.
     */
    match /users/{userId}/projects/{projectId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Secure user blog posts. Only the owner can read, create, update, or delete.
     * @path /users/{userId}/blog_posts/{blogPostId}
     * @allow (create) User with ID 'user123' creates a blog post under their profile.
     * @allow (get) User with ID 'user123' reads blog post 'blogPost456' under their profile.
     * @allow (update) User with ID 'user123' updates blog post 'blogPost456' under their profile.
     * @allow (delete) User with ID 'user123' deletes blog post 'blogPost456' under their profile.
     * @deny (create) User with ID 'user456' attempts to create a blog post for 'user123'.
     * @deny (get) User with ID 'user456' attempts to read a blog post of 'user123'.
     * @principle Enforces document ownership for all operations on user blog posts.
     */
    match /users/{userId}/blog_posts/{blogPostId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Secure contact form submissions. Publicly writable, readable by authenticated users only.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (create) Any user (or no user) can create a contact form submission.
     * @allow (get) Authenticated user can read any contact form submission.
     * @deny (get) Unauthenticated user attempts to read a contact form submission.
     * @principle Allows public submissions but restricts reading to authenticated users.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}