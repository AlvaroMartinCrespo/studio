/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, projects, and blog posts.
 * Only the authenticated user can read and write their own profile data. Projects and blog posts
 * are similarly protected under their respective user's data tree.  Contact form submissions are stored
 * in a top-level collection, where any authenticated user can create a submission. Reading and writing
 * contact form submissions is disallowed for all users.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /users/{userId}/projects/{projectId}: Stores projects associated with a user.
 * - /users/{userId}/blog_posts/{blogPostId}: Stores blog posts created by a user.
 * - /contact_form_submissions/{contactFormSubmissionId}: Stores contact form submissions.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Contact form submissions are write-only by authenticated users; listing and reading is forbidden.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID and that the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces document ownership for writes.
     * @path /users/{userId}
     * @allow (create) request.auth.uid == 'user_abc' with data { id: 'user_abc', ... }
     * @deny (create) request.auth.uid == 'user_xyz' with data { id: 'user_abc', ... } (mismatched user ID)
     * @deny (update) request.auth.uid == 'user_xyz' (not the owner)
     * @principle Enforces document ownership for writes
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Restricts access to projects under a user's data tree.
     * @path /users/{userId}/projects/{projectId}
     * @allow (create) request.auth.uid == 'user_abc' under /users/user_abc/projects/project_123
     * @deny (create) request.auth.uid == 'user_xyz' under /users/user_abc/projects/project_123 (not the owner)
     * @deny (update) request.auth.uid == 'user_xyz' (not the owner)
     * @principle Restricts access to a user's own data tree
     */
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Restricts access to blog posts under a user's data tree.
     * @path /users/{userId}/blog_posts/{blogPostId}
     * @allow (create) request.auth.uid == 'user_abc' under /users/user_abc/blog_posts/post_123
     * @deny (create) request.auth.uid == 'user_xyz' under /users/user_abc/blog_posts/post_123 (not the owner)
     * @deny (update) request.auth.uid == 'user_xyz' (not the owner)
     * @principle Restricts access to a user's own data tree
     */
    match /users/{userId}/blog_posts/{blogPostId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows any authenticated user to create contact form submissions, but restricts reading/listing.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (create) request.auth.uid != null
     * @deny (get) request.auth.uid != null
     * @deny (list) request.auth.uid != null
     * @principle Public writes, restricted reads.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      allow get: if false;
      allow list: if false;

      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}