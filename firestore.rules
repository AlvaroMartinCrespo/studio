/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @Core Philosophy
 * This ruleset is in prototyping mode and prioritizes secure authorization over strict schema validation.
 * It aims to prevent unauthorized data access while allowing flexibility in data shapes for rapid development.
 *
 * @Data Structure
 * The Firestore database contains the following top-level collections:
 * - `/contact_form_submissions/{contactFormSubmissionId}`: Stores contact form submissions.
 *
 * @Key Security Decisions
 * - Contact form submissions are publicly writeable.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create contact form submissions.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (create) Any unauthenticated user can create a contact form submission.
     * @deny (update) No one can update a contact form submission.
     * @principle Allows public writes for contact form submissions.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }
  }
}