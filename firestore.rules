/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by enforcing strict access controls.
 *
 * Data Structure:
 * - `/contact_form_submissions/{contactFormSubmissionId}`: Stores contact form submissions.
 *
 * Key Security Decisions:
 * - Contact form submissions are publicly accessible for reading but require authentication for creation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading any contact form submissions, but requires authentication to create, update, or delete.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (get, list) Anyone can read contact form submissions to allow public display.
     * @allow (create) Authenticated users can submit new contact forms.
     * @deny (update, delete) Updates and deletes are not allowed, preserving submission integrity.
     * @principle Allows public reads for contact submissions, but protects write operations by requiring authentication.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}