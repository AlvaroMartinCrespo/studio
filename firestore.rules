/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for a portfolio application,
 * enforcing a public-read, owner-write model for ContactFormSubmissions.
 *
 * Data Structure:
 * - /contact_form_submissions/{contactFormSubmissionId}: Stores contact form submissions, publicly readable, but only writable by the "owner."
 *
 * Key Security Decisions:
 * - Contact form submissions are readable by everyone.
 * - Writes (create, update, delete) to contact form submissions are disallowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to contact form submissions, but restricts writes.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (get, list): Any user can read contact form submissions.
     * @deny (create, update, delete): No user can create, update, or delete contact form submissions.
     * @principle Public read, restricted write.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}