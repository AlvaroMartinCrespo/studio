/**
 * @file Firestore Security Rules
 * @description This ruleset is in "Prototyping Mode," prioritizing strict authorization and rapid iteration. Data schema validation is minimized.
 *
 * Core Philosophy:
 *   - Secure all data based on user identity (authentication).
 *   - Protect user data and prevent unauthorized access.
 *   - Explicitly deny any access not specifically granted.
 *
 * Data Structure:
 *   - `/contact_form_submissions/{contactFormSubmissionId}`: Stores contact form submissions.  Intended to be only writeable by the application for demo purposes.
 *
 * Key Security Decisions:
 *   - Listing of contact form submissions is explicitly denied.
 *   - Minimal schema validation is performed in this prototyping phase.
 *   - No public data access is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects contact form submissions.
     * @path /contact_form_submissions/{contactFormSubmissionId}
     * @allow (create) - Not applicable, writes only from backend
     * @deny (list) - Any user attempting to list submissions
     * @principle Prevents unauthorized access to contact form submissions. Only the backend should create resources in this collection.
     */
    match /contact_form_submissions/{contactFormSubmissionId} {
      // Anyone cannot list contact form submissions.
      allow list: if false;

      // Nobody can get a contact form submission.
      allow get: if false;

      // Nobody can create contact form submissions.
      allow create: if false;

      // Nobody can update contact form submissions.
      allow update: if false;

      // Nobody can delete contact form submissions.
      allow delete: if false;
    }
  }
}